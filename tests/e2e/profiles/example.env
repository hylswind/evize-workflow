# The secrets a cycle needs, beside the profile that names the account. Copy
# this to <profile>.env, fill it in, and `source` it before running anything:
#
#   set -a; . tests/e2e/profiles/mine.env; set +a
#
# A file rather than a shell history or a chat: the values are typed once, by
# you, and never pass through anything that keeps a record. Everything in
# profiles/ except the two examples is gitignored, and gitignore is the least
# of it — keep this file readable by you alone (chmod 600).

# The key the apply endpoint expects: the value you set as the caller's
# APPLY_API_KEY secret.
export ENCLAVIZE_APPLY_API_KEY=

# Optional. Only to open the console archive stage 1 downloads; the check
# skips without it.
export ENCLAVIZE_CONSOLE_ZIP_PASSWORD=
